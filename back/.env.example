# ─────────────────────────────────────────────
#  JobPilot Backend — Variables de entorno
# ─────────────────────────────────────────────
# Copia este archivo como .env y rellena los valores

NODE_ENV=development
PORT=5000

# ── Base de datos ──────────────────────────────
MONGO_URI=mongodb://localhost:27017/jobpilot

# ── JWT ────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=otro_secreto_diferente_y_muy_largo
REFRESH_TOKEN_EXPIRES_IN=7d

# ── OpenAI ─────────────────────────────────────
OPENAI_API_KEY=sk-...tu_clave_aqui...
OPENAI_MODEL=gpt-4o-mini

# ── Adzuna API (https://developer.adzuna.com) ──
ADZUNA_APP_ID=tu_app_id
ADZUNA_API_KEY=tu_api_key

# ── InfoJobs API (https://developer.infojobs.net) ──
INFOJOBS_CLIENT_ID=tu_client_id
INFOJOBS_CLIENT_SECRET=tu_client_secret

# ── Frontend URL (CORS) ────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate limiting ──────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
